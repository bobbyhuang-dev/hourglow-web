{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hourglow-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-31",
  "routes": [
    {
      "pattern": "hourglow.bobbyhuang.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
